{
  "name": "folder-pins",
  "displayName": "Folder Pins",
  "description": "Keep frequently used folders in a pinned section of the Explorer.",
  "version": "0.1.1",
  "publisher": "local-dev",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "keywords": ["folders", "pins", "explorer", "favorites"],
  "main": "./src/extension.js",
  "activationEvents": ["onView:folderPins.folders"],
  "scripts": {
    "test": "node --test",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  },
  "contributes": {
    "commands": [
      { "command": "folderPins.pin", "title": "Закрепить папку", "category": "Folder Pins", "icon": "$(pin)" },
      { "command": "folderPins.unpin", "title": "Открепить папку", "category": "Folder Pins", "icon": "$(pinned)" },
      { "command": "folderPins.refresh", "title": "Обновить", "category": "Folder Pins", "icon": "$(refresh)" },
      { "command": "folderPins.clear", "title": "Открепить все папки", "category": "Folder Pins" },
      { "command": "folderPins.reveal", "title": "Показать в основном дереве", "category": "Folder Pins", "icon": "$(go-to-file)" }
    ],
    "views": {
      "explorer": [
        { "id": "folderPins.folders", "name": "Закреплённые папки", "icon": "$(pin)", "contextualTitle": "Folder Pins" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "folderPins.folders",
        "contents": "Закрепляй нужные папки, чтобы не искать их в большом проекте.\nПКМ по папке → Закрепить папку.\n[Выбрать папку](command:folderPins.pin)"
      }
    ],
    "menus": {
      "explorer/context": [
        { "command": "folderPins.pin", "when": "explorerResourceIsFolder", "group": "navigation@9" }
      ],
      "view/title": [
        { "command": "folderPins.pin", "when": "view == folderPins.folders", "group": "navigation@1" },
        { "command": "folderPins.refresh", "when": "view == folderPins.folders", "group": "navigation@2" },
        { "command": "folderPins.clear", "when": "view == folderPins.folders", "group": "2_manage" }
      ],
      "view/item/context": [
        { "command": "folderPins.unpin", "when": "view == folderPins.folders && viewItem == pinnedFolder", "group": "inline@1" },
        { "command": "folderPins.pin", "when": "view == folderPins.folders && viewItem == folder", "group": "1_pins" },
        { "command": "folderPins.unpin", "when": "view == folderPins.folders && viewItem == pinnedFolder", "group": "1_pins" },
        { "command": "folderPins.reveal", "when": "view == folderPins.folders", "group": "2_navigation" }
      ],
      "commandPalette": [
        { "command": "folderPins.unpin", "when": "false" },
        { "command": "folderPins.reveal", "when": "false" }
      ]
    }
  }
}
